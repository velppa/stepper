<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Stepper client.  Install:
     cp bin/com.velppa.stepper-client.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.velppa.stepper-client.plist -->
<dict>
	<key>Label</key>
	<string>com.velppa.stepper-client</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>exec make start-client</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/pavel/.velppa/stepper</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/pavel/Library/Logs/stepper-client.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/pavel/Library/Logs/stepper-client.log</string>
</dict>
</plist>
