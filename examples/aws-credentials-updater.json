{
  "Comment": "Refresh the static AWS keys in ~/.aws/credentials from the Identity Center session",
  "QueryLanguage": "JSONata",
  "StartAt": "RefreshCredentials",
  "States": {
    "RefreshCredentials": {
      "Type": "Task",
      "Resource": "arn:m4pro:stepper:::shell:runCommand",
      "Arguments": {
        "command": "/Users/pavel/.velppa/Dotfiles/bin/aws-credentials-update.bb",
        "env": {
          "PATH": "/Users/pavel/.local/share/mise/shims:/opt/local/bin:/usr/local/bin:/usr/bin:/bin"
        },
        "timeout_seconds": 120
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Output": "{% $states.result.stderr %}",
      "End": true
    }
  }
}
